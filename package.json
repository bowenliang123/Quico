{
  "name": "quico",
  "version": "2.0.0",
  "description": "Productive QR Code Generator with efficiency and elegance, just feeling it on the fly. More than a QR code generator.快码二维,疾行如风。",
  "type": "module",
  "private": true,
  "author": "Bowen Liang",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bowenliang123/Quico.git"
  },
  "homepage": "https://github.com/bowenliang123/Quico#readme",
  "keywords": [
    "qrcode",
    "quico",
    "generator",
    "encode",
    "decode"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
